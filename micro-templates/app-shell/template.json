{
  "id": "app-shell",
  "name": "App Shell",
  "type": "shell",
  "description": "Monorepo shell with feature packages, Firebase Auth, and Pinia stores",
  "variables": [
    {
      "name": "org",
      "description": "npm organization scope (e.g., 'myorg')",
      "default": "myorg",
      "required": false
    },
    {
      "name": "projectName",
      "description": "Project name for package.json",
      "required": true
    }
  ],
  "secrets": [],
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "pinia": "^2.1.0",
    "firebase": "^10.0.0"
  },
  "config": {
    "ui": {
      "name": "shell",
      "framework": "vue",
      "sourceDir": "./packages/shell"
    }
  },
  "postInstall": [
    "pnpm install"
  ]
}
