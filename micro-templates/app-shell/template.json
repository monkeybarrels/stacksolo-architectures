{
  "id": "app-shell",
  "name": "App Shell",
  "type": "shell",
  "description": "Monorepo shell with feature packages, Firebase Auth, and state management",
  "frameworks": ["vue", "react"],
  "defaultFramework": "vue",
  "variables": [
    {
      "name": "org",
      "description": "npm organization scope (e.g., 'myorg')",
      "default": "myorg",
      "required": false
    },
    {
      "name": "projectName",
      "description": "Project name for package.json",
      "required": true
    }
  ],
  "secrets": [],
  "config": {
    "ui": {
      "name": "shell",
      "sourceDir": "./packages/shell"
    }
  },
  "postInstall": [
    "pnpm install"
  ]
}
