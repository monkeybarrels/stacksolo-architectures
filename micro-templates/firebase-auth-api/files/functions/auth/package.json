{
  "name": "auth",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --dts",
    "dev": "tsup src/index.ts --format esm --target node20 --watch --onSuccess 'npx @google-cloud/functions-framework --source=dist --target=auth'",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.3.0",
    "@stacksolo/runtime": "^0.1.0",
    "drizzle-orm": "^0.29.0",
    "express": "^4.18.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.20.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
