{
  "name": "admin-api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsup src/index.ts --format esm --target node20 --watch --onSuccess 'npx @google-cloud/functions-framework --source=dist --target=handler --port=${PORT:-8084}'",
    "build": "tsup src/index.ts --format esm --target node20",
    "start": "npx @google-cloud/functions-framework --source=dist --target=handler"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
