{
  "id": "pdf-extractor",
  "name": "PDF Extractor with Gemini",
  "description": "GCS-triggered function that extracts data from PDFs using Google's Gemini AI. Upload a PDF, get structured JSON output.",
  "variables": [
    {
      "name": "projectName",
      "description": "Your project name (lowercase, hyphens only)",
      "type": "string",
      "required": true
    },
    {
      "name": "gcpProjectId",
      "description": "Your GCP project ID",
      "type": "string",
      "required": true
    },
    {
      "name": "region",
      "description": "GCP region for deployment",
      "type": "string",
      "default": "us-central1"
    }
  ],
  "variants": [
    {
      "id": "default",
      "name": "Default",
      "description": "TypeScript Cloud Function with Gemini",
      "filesDir": "files"
    }
  ],
  "dependencies": []
}
