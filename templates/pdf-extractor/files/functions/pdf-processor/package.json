{
  "name": "pdf-processor",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --dts",
    "dev": "tsup src/index.ts --format esm --target node20 --watch --onSuccess 'npx @google-cloud/functions-framework --source=dist --target=handler'",
    "start": "npx @google-cloud/functions-framework --source=dist --target=handler"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.0.0",
    "@google-cloud/storage": "^7.7.0",
    "@google-cloud/vertexai": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
