{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsup src/index.ts --format esm --target node20 --watch --onSuccess 'npx functions-framework --source=dist --target=handler --port=${PORT:-3001}'",
    "build": "tsup src/index.ts --format esm --target node20",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.0",
    "@stacksolo/runtime": "^0.1.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  }
}
