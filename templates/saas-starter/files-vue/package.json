{
  "name": "{{projectName}}",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd functions/api && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "cd functions/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "migrate": "cd functions/api && npm run migrate"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
